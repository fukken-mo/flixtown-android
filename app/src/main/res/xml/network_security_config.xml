<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Xtream server addresses are admin-configurable and commonly run plain HTTP
         (e.g. the initial streamtown.live:8080 panel), so cleartext is allowed by
         default for VOD/API traffic to those hosts. -->
    <base-config cleartextTrafficPermitted="true" />

    <!-- The Flix Town control/activation backend is a fixed, first-party host and
         must always be reached over HTTPS: no cleartext, no exceptions. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tv.streamtown.live</domain>
    </domain-config>
</network-security-config>
