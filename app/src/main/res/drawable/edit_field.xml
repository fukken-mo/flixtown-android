<?xml version="1.0" encoding="utf-8"?>
<!-- Text fields match the buttons: charcoal surface and hairline; a red edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><corners android:radius="10dp"/><solid android:color="#FF26191B"/><stroke android:width="2dp" android:color="@color/flix_glow"/></shape></item>
    <item><shape><corners android:radius="10dp"/><solid android:color="#FF1D1C21"/><stroke android:width="1dp" android:color="#33FFFFFF"/></shape></item>
</selector>
