<?xml version="1.0" encoding="utf-8"?>
<!-- Static cinematic wash: crimson bloom behind the QR card and a darker left edge for the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><gradient android:type="radial" android:gradientRadius="75%p" android:centerX="0.74" android:centerY="0.45"
        android:startColor="#3AAB3A39" android:centerColor="#12AB3A39" android:endColor="#0008080B" /></shape></item>
    <item><shape><gradient android:angle="0" android:startColor="#CC08080B" android:centerColor="#4008080B" android:endColor="#0008080B" /></shape></item>
    <item><shape><gradient android:angle="90" android:startColor="#A008080B" android:centerColor="#0008080B" android:endColor="#6008080B" /></shape></item>
</layer-list>
