<resources>
    <style name="FlixTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/flix_bg</item>
        <item name="android:colorAccent">@color/flix_accent</item>
        <item name="android:colorControlActivated">@color/flix_glow</item>
        <item name="android:textColorHighlight">#66AB3A39</item>
        <item name="android:navigationBarColor">@color/flix_bg</item>
        <item name="android:statusBarColor">@color/flix_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- Player side panel (Audio, Subtitles) slides in from the right. -->
    <style name="PanelAnimation">
        <item name="android:windowEnterAnimation">@anim/panel_in</item>
        <item name="android:windowExitAnimation">@anim/panel_out</item>
    </style>
</resources>
