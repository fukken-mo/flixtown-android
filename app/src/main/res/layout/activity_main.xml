<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#07080B" android:clipChildren="false" android:clipToPadding="false">
    <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="360dp"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <View android:layout_width="match_parent" android:layout_height="370dp"
        android:background="@drawable/hero_scrim" />
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="96dp" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="48dp" android:paddingTop="27dp" android:paddingBottom="27dp">
        <FrameLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="290dp">
            <LinearLayout android:layout_width="450dp" android:layout_height="wrap_content"
                android:layout_gravity="bottom|start" android:orientation="vertical" android:paddingBottom="18dp">
                <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/hero_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:textColor="#C6C7CC" android:textSize="16sp" />
                <TextView android:id="@+id/hero_overview" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:textColor="#A9ABB1" android:textSize="14sp"
                    android:maxLines="3" android:ellipsize="end" />
                <LinearLayout android:id="@+id/hero_actions" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="18dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/filters" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_marginBottom="6dp" android:orientation="horizontal"
                android:visibility="gone" />
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_rows" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
            android:clipChildren="false" android:overScrollMode="never" />
        <TextView android:id="@+id/browse_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="All Movies" android:textColor="#FFFFFF"
            android:textSize="22sp" android:paddingBottom="6dp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/browse_grid" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
            android:clipChildren="false" android:overScrollMode="never" android:visibility="gone" />
    </LinearLayout>
    <View android:id="@+id/dim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99000000" android:visibility="gone" android:focusable="false" />
    <LinearLayout android:id="@+id/rail" android:layout_width="96dp" android:layout_height="match_parent"
        android:background="#E607080B" android:orientation="vertical" android:paddingTop="27dp"
        android:paddingBottom="27dp" android:clipChildren="false" />
    <LinearLayout android:id="@+id/expanded_menu" android:layout_width="240dp" android:layout_height="match_parent"
        android:background="#F507080B" android:orientation="vertical" android:paddingTop="27dp"
        android:paddingBottom="27dp" android:visibility="gone" />
</FrameLayout>
