<?xml version="1.0" encoding="utf-8"?>
<!-- Player. With the overlay hidden nothing but the video is on screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:focusable="true" android:focusableInTouchMode="true">
    <androidx.media3.ui.PlayerView android:id="@+id/player_view"
        android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="false" />

    <FrameLayout android:id="@+id/player_overlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="150dp" android:layout_gravity="top"
            android:background="@drawable/player_scrim" />
        <View android:layout_width="match_parent" android:layout_height="190dp" android:layout_gravity="bottom"
            android:background="@drawable/player_scrim_bottom" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
            android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingTop="30dp">
            <TextView android:id="@+id/player_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/flix_text" android:textSize="26sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:ellipsize="end" android:shadowColor="#99000000" android:shadowRadius="8" />
            <TextView android:id="@+id/player_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/flix_text_2" android:textSize="16sp"
                android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingBottom="30dp"
            android:clipChildren="false" android:clipToPadding="false">
            <TextView android:id="@+id/player_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" android:textColor="@color/flix_text_2" android:textSize="15sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/player_actions" android:layout_width="wrap_content" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="14dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false">
                <TextView android:id="@+id/player_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="64dp" android:text="0:00" android:textColor="@color/flix_text" android:textSize="15sp"
                    android:fontFeatureSettings="tnum" />
                <FrameLayout android:id="@+id/player_progress_slot" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/player_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="72dp" android:gravity="end" android:text="-0:00" android:textColor="@color/flix_text_2"
                    android:textSize="15sp" android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Compact choice card: Continue / Start over, Up next, playback errors. -->
    <LinearLayout android:id="@+id/player_card" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_marginStart="56dp" android:layout_marginBottom="36dp"
        android:minWidth="380dp" android:orientation="vertical" android:background="@drawable/glass_panel"
        android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingTop="20dp" android:paddingBottom="20dp"
        android:visibility="gone" android:clipChildren="false" android:clipToPadding="false">
        <TextView android:id="@+id/player_card_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="560dp" android:textColor="@color/flix_text" android:textSize="21sp" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/player_card_message" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="560dp" android:layout_marginTop="4dp" android:textColor="@color/flix_text_2" android:textSize="15sp"
            android:maxLines="3" android:ellipsize="end" />
        <LinearLayout android:id="@+id/player_card_actions" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
