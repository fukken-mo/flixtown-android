<?xml version="1.0" encoding="utf-8"?>
<!-- QR-first sign in. Everything sits inside the 5% TV safe area (48dp x 27dp on a 960x540dp screen). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/flix_bg">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/login_backdrop" />

    <!-- QR activation (primary) -->
    <LinearLayout android:id="@+id/qr_panel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="64dp" android:paddingEnd="64dp" android:paddingTop="27dp" android:paddingBottom="27dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingEnd="32dp">
            <ImageView android:layout_width="190dp" android:layout_height="131dp" android:src="@drawable/flix_logo"
                android:scaleType="fitStart" android:contentDescription="Flix Town" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="Your movies are waiting." android:textColor="@color/flix_text" android:textSize="32sp"
                android:fontFamily="sans-serif-medium" android:maxLines="2" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Activate this TV with your phone. It only takes a moment." android:textColor="@color/flix_text_2"
                android:textSize="17sp" android:maxLines="2" />
            <TextView android:id="@+id/steps" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:textColor="@color/flix_text" android:textSize="16sp"
                android:lineSpacingMultiplier="1.45" />
            <Button android:id="@+id/remote_sign_in" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginTop="20dp" android:layout_marginStart="-3dp" android:text="Sign in with remote instead" android:textAllCaps="false"
                android:textSize="16sp" android:textColor="@color/flix_text" android:fontFamily="sans-serif-medium"
                android:paddingStart="22dp" android:paddingEnd="22dp" android:minWidth="0dp" android:minHeight="0dp"
                android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="320dp" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center_horizontal" android:background="@drawable/glass_panel"
            android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="26dp" android:paddingBottom="22dp">
            <FrameLayout android:layout_width="236dp" android:layout_height="236dp" android:background="@drawable/qr_frame"
                android:padding="10dp">
                <ImageView android:id="@+id/qr_image" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:contentDescription="Activation QR code" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:gravity="center" android:text="Or visit myflixtown.com/activate.php\nand enter this code" android:textColor="@color/flix_text_3"
                android:textSize="13sp" android:lineSpacingMultiplier="1.1" />
            <TextView android:id="@+id/activation_code" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="······" android:textColor="@color/flix_text"
                android:textSize="28sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.18" />
            <TextView android:id="@+id/login_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Preparing your code…" android:textColor="@color/flix_text_2"
                android:textSize="14sp" android:drawablePadding="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Remote sign in (secondary). Kept in the top half so the on-screen keyboard never covers it. -->
    <LinearLayout android:id="@+id/remote_panel" android:layout_width="460dp" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="36dp" android:orientation="vertical"
        android:paddingStart="30dp" android:paddingEnd="30dp" android:paddingTop="24dp" android:paddingBottom="24dp"
        android:background="@drawable/glass_panel" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sign in with remote" android:textColor="@color/flix_text" android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Select a field and press OK to type." android:textColor="@color/flix_text_3" android:textSize="14sp" />
        <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="16dp" android:singleLine="true" android:hint="Username" android:imeOptions="actionNext"
            android:inputType="text" android:textColor="@color/flix_text" android:textColorHint="@color/flix_text_3"
            android:background="@drawable/edit_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="17sp" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="10dp" android:singleLine="true" android:hint="Password" android:imeOptions="actionDone"
            android:inputType="textPassword" android:textColor="@color/flix_text" android:textColorHint="@color/flix_text_3"
            android:background="@drawable/edit_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="17sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:layout_marginStart="-3dp" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
            <Button android:id="@+id/sign_in" android:layout_width="wrap_content" android:layout_height="52dp" android:minWidth="150dp"
                android:text="Sign in" android:textAllCaps="false" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                android:paddingStart="26dp" android:paddingEnd="26dp" android:stateListAnimator="@null" android:minHeight="0dp" />
            <Button android:id="@+id/back_to_qr" android:layout_width="wrap_content" android:layout_height="52dp" android:minWidth="150dp"
                android:layout_marginStart="10dp" android:text="Use QR code" android:textAllCaps="false" android:textSize="17sp"
                android:fontFamily="sans-serif-medium" android:paddingStart="26dp" android:paddingEnd="26dp"
                android:stateListAnimator="@null" android:minHeight="0dp" />
        </LinearLayout>
        <TextView android:id="@+id/login_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/flix_error" android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
