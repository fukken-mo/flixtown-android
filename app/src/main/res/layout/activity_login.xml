<?xml version="1.0" encoding="utf-8"?>
<!-- QR-first sign in. Everything sits inside the 5% TV safe area (48dp x 27dp on a 960x540dp screen).
     The QR card is the main path; "Sign in with remote" is a small secondary option. The keyboard
     only appears in the remote form (QR panel hidden), so it can never cover the QR instructions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/flix_bg">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/login_backdrop" />

    <!-- QR activation (primary) -->
    <LinearLayout android:id="@+id/qr_panel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false"
        android:paddingStart="64dp" android:paddingEnd="64dp" android:paddingTop="27dp" android:paddingBottom="27dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingEnd="40dp" android:clipChildren="false" android:clipToPadding="false">
            <ImageView android:layout_width="150dp" android:layout_height="104dp" android:src="@drawable/flix_logo"
                android:scaleType="fitStart" android:contentDescription="Flix Town" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="Your movies are waiting." android:textColor="@color/flix_text" android:textSize="31sp"
                android:fontFamily="sans-serif-medium" android:maxLines="2" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Scan the code with your phone to activate this TV." android:textColor="@color/flix_text_2"
                android:textSize="17sp" android:maxLines="2" />
            <View android:layout_width="36dp" android:layout_height="3dp" android:layout_marginTop="22dp" android:background="@color/flix_accent" />
            <TextView android:id="@+id/steps" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textColor="@color/flix_text" android:textSize="16sp"
                android:lineSpacingMultiplier="1.5" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No phone handy?"
                    android:textColor="@color/flix_text_3" android:textSize="14sp" />
                <Button android:id="@+id/remote_sign_in" android:layout_width="wrap_content" android:layout_height="42dp"
                    android:layout_marginStart="10dp" android:text="Sign in with remote" android:textAllCaps="false"
                    android:textSize="14sp" android:fontFamily="sans-serif-medium" android:singleLine="true"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:minWidth="196dp" android:minHeight="0dp" android:gravity="center"
                    android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="336dp" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center_horizontal" android:background="@drawable/glass_panel"
            android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="22dp" android:paddingBottom="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCAN TO ACTIVATE"
                android:textColor="@color/flix_glow" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.16" />
            <FrameLayout android:layout_width="244dp" android:layout_height="244dp" android:layout_marginTop="12dp"
                android:background="@drawable/qr_frame" android:padding="10dp">
                <ImageView android:id="@+id/qr_image" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:contentDescription="Activation QR code" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:gravity="center" android:text="Or go to myflixtown.com/activate.php\nand enter this code" android:textColor="@color/flix_text_3"
                android:textSize="13sp" android:lineSpacingMultiplier="1.12" />
            <TextView android:id="@+id/activation_code" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="······" android:textColor="@color/flix_text"
                android:textSize="28sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.18" />
            <TextView android:id="@+id/login_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Preparing your code…" android:textColor="@color/flix_text_2"
                android:textSize="14sp" android:gravity="center" android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <!-- Remote sign in (secondary). Kept in the top half so the on-screen keyboard never covers it. -->
    <LinearLayout android:id="@+id/remote_panel" android:layout_width="480dp" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="32dp" android:orientation="vertical"
        android:paddingStart="30dp" android:paddingEnd="30dp" android:paddingTop="22dp" android:paddingBottom="22dp"
        android:background="@drawable/glass_panel" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sign in with your remote" android:textColor="@color/flix_text" android:textSize="23sp"
                    android:fontFamily="sans-serif-medium" android:singleLine="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:text="Select a field, then press OK to type." android:textColor="@color/flix_text_3" android:textSize="14sp" />
            </LinearLayout>
            <!-- Accounts are digits; older accounts may contain letters, so the full keyboard is one press away. -->
            <Button android:id="@+id/keyboard_mode" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="12dp" android:text="ABC" android:textAllCaps="false" android:textSize="14sp"
                android:fontFamily="sans-serif-medium" android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="0dp"
                android:minHeight="0dp" android:stateListAnimator="@null" android:contentDescription="Switch keyboard" />
        </LinearLayout>
        <!-- Messages sit above the fields: the on-screen keyboard covers the lower half of the screen. -->
        <TextView android:id="@+id/login_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/flix_error" android:textSize="15sp" android:maxLines="2"
            android:visibility="gone" />
        <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="16dp" android:singleLine="true" android:hint="Username" android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="number" android:textColor="@color/flix_text" android:textColorHint="@color/flix_text_3"
            android:background="@drawable/edit_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="18sp"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.04" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="10dp" android:singleLine="true" android:hint="Password" android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="numberPassword" android:textColor="@color/flix_text" android:textColorHint="@color/flix_text_3"
            android:background="@drawable/edit_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="18sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:layout_marginStart="-3dp" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
            <Button android:id="@+id/sign_in" android:layout_width="wrap_content" android:layout_height="50dp" android:minWidth="140dp"
                android:text="Sign in" android:textAllCaps="false" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                android:paddingStart="26dp" android:paddingEnd="26dp" android:stateListAnimator="@null" android:minHeight="0dp" />
            <Button android:id="@+id/back_to_qr" android:layout_width="wrap_content" android:layout_height="50dp" android:minWidth="140dp"
                android:layout_marginStart="8dp" android:text="Use QR code" android:textAllCaps="false" android:textSize="17sp"
                android:fontFamily="sans-serif-medium" android:paddingStart="26dp" android:paddingEnd="26dp"
                android:stateListAnimator="@null" android:minHeight="0dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
