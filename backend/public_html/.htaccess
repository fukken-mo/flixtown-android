# Flix Town control backend - public_html hardening.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</IfModule>

Options -Indexes
Options -MultiViews

# Never serve schema/docs/logs if they end up under the web root by mistake.
<FilesMatch "\.(sql|md|log|env)$">
    Require all denied
</FilesMatch>

# Deny access to the secrets/includes tree even if it is ever placed under
# public_html by mistake during deployment.
RewriteEngine On
RewriteRule ^(secrets\.php|includes/) - [F,L]

# Clean activation URL shown on the TV screen: flixtown.panelsandapps.com/pair
RewriteRule ^pair/?$ pair.php [L,QSA]
