# Seasonal pictures only: never run anything here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<FilesMatch "^[a-z0-9_]+-[0-9a-f]{16}\.jpg$">
  Require all granted
</FilesMatch>
<FilesMatch "^(?![a-z0-9_]+-[0-9a-f]{16}\.jpg$).*$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options nosniff
</IfModule>
